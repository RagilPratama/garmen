{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "start": "concurrently --kill-others-on-fail --names \"Laravel,Vite\" --prefix-colors \"blue,yellow\" \"php artisan serve --port=8000\" \"vite\"",
        "format": "prettier --write \"**/*.{vue,js,ts,json,css,scss,md}\"",
        "format:check": "prettier --check \"**/*.{vue,js,ts,json,css,scss,md}\"",
        "prepare": "husky"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.16.1",
        "concurrently": "^9.2.1",
        "eslint": "^10.4.0",
        "eslint-plugin-vue": "^10.9.1",
        "husky": "^9.0.0",
        "laravel-vite-plugin": "^3.0.0",
        "lint-staged": "^15.0.0",
        "prettier": "^3.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "@headlessui/vue": "^1.7.23",
        "@heroicons/vue": "^2.2.0",
        "@inertiajs/vue3": "^3.0.3",
        "@vitejs/plugin-vue": "^6.0.5",
        "html5-qrcode": "^2.3.8",
        "jsbarcode": "^3.12.3",
        "jspdf": "^4.2.1",
        "jspdf-autotable": "^5.0.7",
        "sweetalert2": "^11.26.24",
        "vue": "^3.5.32"
    }
}
